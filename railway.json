{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace apps/web",
    "watchPatterns": [
      "apps/web/**",
      "packages/shared/**",
      "package.json",
      "package-lock.json",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start --workspace apps/web",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
