{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run build --workspace apps/web"
  },
  "deploy": {
    "startCommand": "npm run start --workspace apps/web",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
