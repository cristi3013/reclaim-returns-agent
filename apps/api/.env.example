PORT=3000
SAP_MODE=mock
GATEWAY_URL=https://o2c-returns-agent.cfapps.ap21.hana.ondemand.com/odata/v4/returns
AI_MODE=assisted
# Model provider: either an Anthropic API key, or AWS keys for Amazon Bedrock (EU inference profile by default)
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# Optional model override. Anthropic: claude-opus-5-5. Bedrock: eu.anthropic.claude-opus-5-5 (default) or eu.anthropic.claude-sonnet-4-6 (native structured output)
CLAUDE_MODEL=
