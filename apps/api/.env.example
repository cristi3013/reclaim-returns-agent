PORT=3000
SAP_MODE=mock
GATEWAY_URL=https://o2c-returns-agent.cfapps.ap21.hana.ondemand.com/odata/v4/returns
AI_MODE=assisted
# Model provider: either an Anthropic API key, or AWS keys for Amazon Bedrock (EU inference profile by default)
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# Optional model override. Anthropic: claude-opus-5-5. Bedrock: eu.anthropic.claude-opus-5-5 (default) or eu.anthropic.claude-sonnet-4-6 (native structured output)
CLAUDE_MODEL=
# Optional persistence (write-through). Run apps/api/supabase/schema.sql once in the Supabase SQL editor.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional mailbox intake over IMAP in push mode (IDLE): a complaint appears within seconds. Gmail: enable IMAP, 2-step verification, app password.
# IMAP_POLL_MS is only a safety sweep (min 60 s).
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_POLL_MS=60000
# Comma-separated sender domains to accept (empty = everyone). EMAIL_* names (EMAIL_HOST, EMAIL_USER, EMAIL_PASSWORD, EMAIL_ALLOWED_DOMAINS, EMAIL_ENABLED) are accepted too.
IMAP_ALLOWED_DOMAINS=
# Public base URL of this API (attachment links). Default http://localhost:PORT
PUBLIC_URL=
# Run every inbound complaint automatically (default true)
INBOUND_AUTORUN=true
\n\n# How often to pull cases written by other backend instances sharing the same Supabase (ms). 0 disables.\nSYNC_INTERVAL_MS=10000\n